{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "memory": 1024,
            "maxDuration": 60,
            "excludeFiles": "{storage/**,tests/**,cliente/**,AUTOS/**,.git/**}"
        }
    },
    "rewrites": [
        { "source": "/assets/:path*", "destination": "/public/assets/:path*" },
        { "source": "/robots.txt", "destination": "/public/robots.txt" },
        { "source": "/(.*)", "destination": "/api/index.php" }
    ],
    "crons": [
        {
            "path": "/api/cron/alertas",
            "schedule": "0 12 * * *"
        }
    ]
}
