{
    "name": "drivexperience/gestao",
    "description": "Sistema de gestão operacional e comercial da Drive Xperience",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
