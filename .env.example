APP_ENV=local
APP_DEBUG=1
APP_KEY=
APP_URL=http://localhost:8080

# sqlite para desenvolvimento local.
# mysql ou pgsql para produção e para a Vercel (Supabase = pgsql).
DB_DRIVER=sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
# Para Supabase/PostgreSQL use DB_SSLMODE=require (padrão quando DB_DRIVER=pgsql).
DB_SSLMODE=require

# Preenchidos apenas no procedimento de instalação. Não use senha padrão.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Obrigatório para instalar pela web na Vercel. Remova depois da instalação.
INSTALL_TOKEN=

# Opcional. Permite redefinir a senha de um administrador se todos perderem o acesso.
EMERGENCY_RESET_TOKEN=

# Protege o endpoint de alertas e limpeza. A Vercel Cron deve enviar Authorization: Bearer <segredo>.
CRON_SECRET=

# 1 carrega dados fictícios marcados como demonstração. Nunca use em produção.
SEED_DEMO=0

# Armazenamento de PDFs e uploads: database (padrão, persiste no MySQL/PostgreSQL) ou s3.
STORAGE_DRIVER=database
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# E-mail. Sem estas variáveis o sistema registra a notificação como não configurada e não simula envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Drive Xperience
SMTP_ENCRYPTION=tls

# WhatsApp. Endereço base da instância e token, no ambiente do servidor. Sem os dois, nada é enviado.
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
